# Local Compose defaults only. Never real passwords: this file is public.
# Copy to .env (git-ignored) for local runs.

# Migrations (drizzle-kit): the owner role, pulse. The API never reads this
MIGRATION_DATABASE_URL=postgres://pulse:pulse@127.0.0.1:5432/pulse

# API (apps/api). Connect as pulse_app: row-level security only limits that role.
# Password set by infra/compose/postgres/init/01-app-role.sql
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://pulse_app:pulse_app@127.0.0.1:5432/pulse
# Admin routes until sign-in exists: Authorization: Bearer <ADMIN_TOKEN>. Unset = every admin
# call answers 401. No value here on purpose (this file is public); make your own in .env with:
#   echo "ADMIN_TOKEN=$(openssl rand -hex 32)" >> .env
# ADMIN_TOKEN=

# Worker (apps/worker). Compose Kafka on the host listener, one broker
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=pulse-worker
KAFKA_REPLICATION_FACTOR=1
KAFKA_MIN_INSYNC_REPLICAS=1

# Outbox relay (apps/worker). Connect as pulse_relay: it may only read and mark outbox rows.
# Password set by infra/compose/postgres/init/02-relay-role.sql
RELAY_DATABASE_URL=postgres://pulse_relay:pulse_relay@127.0.0.1:5432/pulse
# Rows per Kafka send, and the wait between polls when the outbox is empty (ms)
RELAY_BATCH_SIZE=100
RELAY_POLL_MS=500

# Other Compose services
REDIS_URL=redis://127.0.0.1:6379
AMQP_URL=amqp://pulse:pulse@127.0.0.1:5672
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
