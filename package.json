{
  "name": "pulse",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/compose/compose.yaml --profile core --profile events --profile queue up -d --wait",
    "infra:down": "docker compose -f infra/compose/compose.yaml --profile '*' down",
    "infra:ps": "docker compose -f infra/compose/compose.yaml --profile '*' ps",
    "infra:logs": "docker compose -f infra/compose/compose.yaml --profile '*' logs -f --tail 100",
    "infra:reset": "docker compose -f infra/compose/compose.yaml --profile '*' down -v",
    "infra:smoke": "sh infra/compose/smoke.sh",
    "api:postman": "postman collection run 'postman/collections/Pulse API' -e 'postman/environments/Pulse local.environment.yaml'",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:int": "turbo run test:int",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1"
  }
}
